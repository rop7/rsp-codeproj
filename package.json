{
  "name": "@rop7/rsp-codeproj",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "version": "1.57.0",
  "main": "src/api/index.js",
  "bin": {
    "proj": "src/bin/index.js",
    "nproj": "src/bin/index.js",
    "codeproj": "src/bin/index.js",
    "rsp-codeproj": "src/bin/index.js"
  },
  "scripts": {
    "inst": "pnpm install --force",
    "postinst": "sudo npm install -g --force",
    "pub": "git push origin dev && npm publish",
    "vinc": "npm version minor --no-git-tag-version",
    "commit": "git add . && git commit -m $(uuidgen)",
    "up": "npm run vinc && npm run commit && npm run pub"
  },
  "author": "@ropsoft <rop@ropsoft.cloud>",
  "license": "ISC",
  "description": "Manage git based code project on @RSp",
  "dependencies": {
    "@rop7/rsp-libcore.js": "^1.3.5",
    "shelljs": "^0.9.2",
    "uuid": "^11.1.0"
  }
}
